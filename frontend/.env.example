# ── 管理端（Vite）环境变量示例 ──
# 用法：cp .env.example .env，再按本机情况修改。

# Vite 开发服务器
VITE_HOST=127.0.0.1
VITE_PORT=5173

# /api 代理目标（后端 API 地址，后端默认 5059）
VITE_API_TARGET=http://127.0.0.1:5059

# 前端请求前缀（默认 /api，走 Vite 代理；若直连后端可改成 http://127.0.0.1:5059/api）
VITE_API_BASE_URL=/api
VITE_REQUEST_TIMEOUT=15000

# 与后端 appsettings.json 的 SuperAdminUsername / StoreManagerUsername 保持一致
VITE_SUPER_ADMIN_USERNAME=admin
VITE_STORE_MANAGER_USERNAME=E001
